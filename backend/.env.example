# ========== 远程推理（推荐上线）：阿里云百炼 OpenAI 兼容模式 ==========
# 设置后后端不再加载本地权重，只 HTTP 调用推理服务（与 openai SDK compatible-mode 等价）。
# 百炼控制台创建 API Key 后填入 DASHSCOPE_API_KEY（或 REMOTE_INFERENCE_API_KEY）。
# REMOTE_INFERENCE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# REMOTE_INFERENCE_MODEL=qwen2.5-7b-instruct-306e22f5efa6-1
# DASHSCOPE_API_KEY=sk-xxx
# REMOTE_INFERENCE_TIMEOUT=300
# Qwen 思考链：默认关闭（对应 SDK extra_body.enable_thinking=false）
# REMOTE_INFERENCE_ENABLE_THINKING=0
# 通用 instruct 模型建议 0（附带 system 提示词）；已微调「只收正文」部署保持 1
# REMOTE_INFERENCE_BODY_ONLY=0
#
# 其它 OpenAI 兼容服务（vLLM / AutoDL 等）仍可用，URL 可只填映射根（自动补全 /v1/chat/completions）：
# REMOTE_INFERENCE_URL=https://你的实例.westd.seetacloud.com:8443
# REMOTE_INFERENCE_MODEL=kiterforth
# REMOTE_INFERENCE_API_KEY=
# 远程单次 max_tokens 上限（论文章节较长时请保持足够大，避免输出半截）
# REMOTE_REDUCE_MAX_TOKENS=3072
# 降 AIGC：整段词数与原文差超过该值、或与原文几乎相同时自动再请求模型；每段最多生成 REDUCE_REVIEW_MAX_ATTEMPTS 次（含首次）
# REDUCE_RETRY_MAX_WORD_DELTA=30
# REDUCE_REVIEW_MAX_ATTEMPTS=3
# 兼容旧名：REDUCE_WORDCOUNT_MISMATCH_RETRIES=2 表示「额外 2 次」即共 3 次（仅在未设置 REDUCE_REVIEW_MAX_ATTEMPTS 时生效）
# 长段与原文相似度过低时重试（可能跑题）；默认 0 关闭，例如 0.45 开启
# REDUCE_SIMILARITY_MIN_RATIO=0
# 润色：字数差与相似度审查，未达标重生成，每段最多 POLISH_REVIEW_MAX_ATTEMPTS 次（含首次）
# POLISH_REVIEW_MAX_ATTEMPTS=3
# POLISH_REVIEW_WORD_DELTA_RATIO=0.38
# POLISH_SIMILARITY_MAX_RATIO=0.989
# POLISH_SIMILARITY_MIN_RATIO=0.76
# 降 AIGC：按逗号句号切段时每段最大字符数（依次请求模型后拼接）
# REDUCE_CHUNK_MAX_CHARS=70
# 主流程（降 AIGC / 润色）对远程服务只发送当前段落正文，不带 system 提示词。

# ========== CORS（可选）==========
# 不配 CORS_ALLOW_ORIGINS 时：开发态默认 CORS=*（解决本地端口漂移导致登录失败）
# 一旦配置了 CORS_ALLOW_ORIGINS，则只信任列表中的源（上线请必配你的前端域名）
# CORS_ALLOW_ORIGINS=https://你的线上前端域名

# ========== 数据库 ==========
# PostgreSQL 连接串（SQLAlchemy 2.x + psycopg）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/paper_polish

# ========== 人机验证（Cloudflare Turnstile，可选但推荐）==========
# 后端校验密钥；配置后 /api/auth/email/send-code 会强制验证 captcha_token
# TURNSTILE_SECRET_KEY=0x4AAAA...

# ========== JWT（多实例 / 本地数学题验证码）==========
# 多 worker 或负载均衡时必配，且各实例需相同
# JWT_SECRET_KEY=请替换为随机长字符串

# ========== 人机验证（Turnstile）==========
# 云端域名需在 Cloudflare Turnstile 站点里加入「主机名」白名单（如 yourdomain.com），
# 否则控件空白；localhost 与生产域名通常需分开两个 Site Key 或同一站点添加多个域名。

# ========== 邮件验证码（QQ 邮箱 SMTP）==========
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=你的QQ邮箱@qq.com
# SMTP_PASSWORD=你的QQ邮箱SMTP授权码
# SMTP_FROM_EMAIL=你的QQ邮箱@qq.com
# SMTP_FROM_NAME=论文润色助手

# ========== 本机加载权重（开发机）：需 pip install -r requirements-local-llm.txt ==========
# 本地模型目录（建议使用绝对路径）
# LOCAL_MODEL_DIR=D:/1code/cursor/downAiGC/kiterforth

# 运行时模型名（支持 @kiterforth 这种仓库内目录别名）
# LOCAL_MODEL_NAME=@kiterforth
# LOCAL_REDUCE_MODEL=@kiterforth
# LOCAL_POLISH_MODEL=@kiterforth

# 推理设备与精度：
# - LOCAL_MODEL_DEVICE=auto / cpu / cuda
# - LOCAL_MODEL_DTYPE=auto / float16 / bfloat16 / float32
# LOCAL_MODEL_DEVICE=auto
# LOCAL_MODEL_DTYPE=auto

# 降 AIGC 采样
# LOCAL_REDUCE_TEMPERATURE=0.78
# LOCAL_REDUCE_TOP_P=0.93
# LOCAL_REDUCE_MAX_NEW_TOKENS=1024

# 润色采样（略稳）
# LOCAL_POLISH_TEMPERATURE=0.58
# LOCAL_POLISH_TOP_P=0.9
# LOCAL_POLISH_MAX_NEW_TOKENS=1024

# ========== 微信扫码看广告 H5 票据（可选，非小程序码）==========
# 扫码打开的 H5 与接口同源时，填后端公网 HTTPS 根地址（与微信 request / 业务域名白名单一致）
# AD_WATCH_PUBLIC_BASE=https://你的-api-域名
# 暂时关闭远程/本地模型调用，段落处理走 mock（上线前改回 0）
MODEL_INFERENCE_DISABLED=1

# 看广奖励字数（默认 1000 字/次）
# AD_WATCH_REWARD_POINTS=2888
# 充值：1 元 = 3000 字（默认）
# POINTS_PER_YUAN=3000
# AD_WATCH_HMAC_SECRET=请替换为随机长字符串
# AD_WATCH_TICKET_TTL_SECONDS=900

# ========== 扫码看广（小程序 QR 推广，代理到 8001）==========
# ADHUB_PROXY_BASE=http://127.0.0.1:8001

# 管理员后台 /api/admin/*：设置后仅列表内邮箱可访问；不配则任意已登录用户可访问（仅适合本地开发）
# ADMIN_EMAILS=admin@example.com,ops@example.com

# 第二遍审稿（从跑偏输出里只抽正文）。1=开启
# LOCAL_REVIEWER_ENABLED=0
# LOCAL_REVIEWER_MODEL=@kiterforth
